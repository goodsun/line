# LINE Developers Console で発行したLIFF ID
# 例: LIFF_ID=1234567890-AbCdEfGh
LIFF_ID=

# IDトークン検証に使うチャネルID（LIFF IDの「-」より前の数字部分と一致）
# 例: LINE_CHANNEL_ID=1234567890
LINE_CHANNEL_ID=

# Messaging APIチャネル（同一プロバイダで別途作成）
# チャネルアクセストークン（長期）とチャネルシークレット
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# プライバシーポリシー(privacy.php)に表示する事業者情報
OPERATOR_NAME=
CONTACT_EMAIL=
PRIVACY_EFFECTIVE_DATE=
